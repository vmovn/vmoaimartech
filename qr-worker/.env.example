# Copy to .env and fill in. Never commit the real file.
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Must match the Swiffer project secrets of the same name.
WA_QR_WORKER_TOKEN=
WA_QR_WORKER_SIGNING_SECRET=
WA_QR_WEBHOOK_SECRET=

# Swiffer webhook endpoint the worker posts events to.
SWIFFER_WEBHOOK_URL=https://app.example.com/api/public/whatsapp/qr-webhook

# Persistent Baileys credential storage (must survive restarts).
WA_AUTH_DIR=./data/auth
