# -----------------------------------------------------------------------------
# Swiffer — Environment template
# Copy to .env.development, .env.staging, .env.production and fill in values.
# NEVER commit real secrets.  Use your platform's secret store in production
# (Docker Swarm secrets, Kubernetes Secrets, AWS SSM/Secrets Manager, etc.).
# -----------------------------------------------------------------------------

# ---- Public (bundled into the client, safe to expose) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=production            # development | staging | production
# --- Environment Mode System (single source of truth: see docs/demo-mode.md) ---
APP_MODE=production                # demo | production   (server-side)
VITE_APP_MODE=production           # demo | production   (client bundle)
# Legacy aliases (still honored if APP_MODE is unset):
DEMO_MODE=false
VITE_DEMO_MODE=false

# ---- Server-only (never expose to the browser) ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # ⚠ bypasses RLS — server-only

# ---- App runtime ----
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://app.example.com  # canonical URL, used for OAuth callbacks & CORS
LOG_LEVEL=info                      # trace|debug|info|warn|error

# ---- Signing / session ----
SESSION_SECRET=                     # openssl rand -hex 32
WEBHOOK_SECRET=                     # openssl rand -hex 32

# ---- Provider integrations ----
LOVABLE_API_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Scaling & ops ----
APP_REPLICAS=2
SWIFFER_VERSION=latest
