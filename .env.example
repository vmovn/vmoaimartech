# Product deployment environment template
# Copy this complete file into Coolify. Fill every REQUIRED value.
# Never commit real values. Variables prefixed VITE_ are public and bundled into the browser.

# ==================================================
# REQUIRED — CORE (server-only unless marked public)
# ==================================================
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=
SESSION_SECRET=

# Public/browser-safe. These normally mirror SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ==================================================
# REQUIRED — FIRST SETUP SECURITY (server-only)
# ==================================================
# Use at least 24 random characters. Example generator: openssl rand -hex 32
SETUP_SECRET=

# ==================================================
# OPTIONAL — APPLICATION RUNTIME
# ==================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_VERSION=1.0.0
APP_COMMIT=
PUBLIC_BASE_URL=/
VITE_APP_ENV=production
VITE_BRAND_NAME=
VITE_DEBUG_COUNTS=0
VITE_AUDIT_VERBOSE=false

# ==================================================
# OPTIONAL — AI
# Core setup and normal non-AI features work without these values.
# ==================================================
LOVABLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KB_VECTOR_STORE=pgvector

# ==================================================
# OPTIONAL — EMAIL
# ==================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==================================================
# OPTIONAL — WHATSAPP / META / MESSENGER / INSTAGRAM
# ==================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
MESSENGER_WEBHOOK_VERIFY_TOKEN=
IG_WEBHOOK_VERIFY_TOKEN=
META_TOKEN_ENCRYPTION_KEY=
APP_USER_CONNECTION_KEY_SECRET=
WA_QR_WORKER_URL=
WA_QR_WORKER_TOKEN=
WA_QR_WORKER_SIGNING_SECRET=
WA_QR_WEBHOOK_SECRET=

# ==================================================
# OPTIONAL — ZALO (reserved for a later integration)
# ==================================================
ZALO_OA_ACCESS_TOKEN=

# ==================================================
# OPTIONAL — BILLING
# ==================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_ENV=sandbox
PADDLE_WEBHOOK_SECRET=

# ==================================================
# OPTIONAL — OTHER INTEGRATIONS
# ==================================================
TELEGRAM_BOT_TOKEN=
TWILIO_AUTH_TOKEN=

# ==================================================
# OPTIONAL — SIGNING / INTERNAL AUTOMATION (server-only)
# Configure only when the corresponding feature is enabled.
# ==================================================
INTERNAL_CRON_TOKEN=
WEBHOOK_DISPATCH_SECRET=
WIDGET_SIGNING_SECRET=
SWIFFER_API_KEY=
SWIFFER_WEBHOOK_SECRET=

# Test-harness variables are intentionally omitted from production defaults.
