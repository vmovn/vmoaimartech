# Canonical Product environment template.
# Never commit real values. VITE_* values are intentionally browser-visible.
# Requiredness and ownership: docs/engineering/ENVIRONMENT-VARIABLES.md

# ==================================================
# REQUIRED — CORE SERVER RUNTIME
# ==================================================
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=
SESSION_SECRET=
SETUP_SECRET=

# ==================================================
# REQUIRED — PUBLIC BUILD VALUES
# ==================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ==================================================
# OPTIONAL — APPLICATION / DEPLOYMENT
# ==================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PASSENGER_PORT=
LOG_LEVEL=info
APP_VERSION=1.0.0
APP_COMMIT=
PUBLIC_BASE_URL=/
VITE_APP_ENV=production
VITE_BRAND_NAME=
VITE_DOCS_BASE_URL=
DEPLOY_TARGET=node
NITRO_PRESET=
APP_REPLICAS=2
PMAI_VERSION=4.4.6

# ==================================================
# CONDITIONAL — PLATFORM SERVICES
# ==================================================
INTERNAL_CRON_TOKEN=
WEBHOOK_DISPATCH_SECRET=
WIDGET_SIGNING_SECRET=
APP_USER_CONNECTION_KEY_SECRET=

# ==================================================
# CONDITIONAL — AI PROVIDERS
# ==================================================
LOVABLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_AI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_UTILITY_MODEL=
# Optional in-flight caps for shared platform Ollama (defaults: 2 global, 1 per workspace)
OLLAMA_MAX_CONCURRENCY=
OLLAMA_WORKSPACE_MAX_CONCURRENCY=
AI_CREDENTIAL_ENCRYPTION_KEY=
KB_VECTOR_STORE=pgvector

# ==================================================
# CONDITIONAL — WHATSAPP CLOUD / META
# ==================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
MESSENGER_WEBHOOK_VERIFY_TOKEN=
IG_WEBHOOK_VERIFY_TOKEN=
META_TOKEN_ENCRYPTION_KEY=

# ==================================================
# CONDITIONAL — WHATSAPP QR WORKER
# ==================================================
WA_QR_WORKER_URL=
WA_QR_WORKER_TOKEN=
WA_QR_WORKER_SIGNING_SECRET=
WA_QR_WEBHOOK_SECRET=
PMAI_WEBHOOK_URL=
WA_AUTH_DIR=./data/auth

# ==================================================
# CONDITIONAL — TELEGRAM / EMAIL / SMS
# ==================================================
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
TWILIO_AUTH_TOKEN=

# ==================================================
# CONDITIONAL — BILLING
# ==================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_ENV=sandbox
PADDLE_WEBHOOK_SECRET=

# ==================================================
# CONDITIONAL — CALENDAR OAUTH
# ==================================================
GOOGLE_CALENDAR_APP_USER_CONNECTOR_CLIENT_API_KEY=
MICROSOFT_OUTLOOK_APP_USER_CONNECTOR_CLIENT_API_KEY=

# ==================================================
# DEVELOPMENT ONLY — DO NOT COPY TO COOLIFY
# ==================================================
VITE_DEBUG_COUNTS=0
VITE_AUDIT_VERBOSE=false
SUPABASE_PROJECT_ID=vmoaimartech-local
VITE_SUPABASE_PROJECT_ID=vmoaimartech-local
SUPABASE_TELEMETRY_DISABLED=1

# ==================================================
# CI / TEST ONLY — DO NOT COPY TO COOLIFY
# The RLS harness is disabled when RLS_TEST_HARNESS_SECRET is empty.
# ==================================================
RLS_TEST_HARNESS_SECRET=
RLS_TEST_HARNESS_ALLOW_PROD=0
E2E_BASE_URL=
CI=
PGHOST=
GITHUB_STEP_SUMMARY=
