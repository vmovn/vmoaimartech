# Local development template. Generate actual values with `npm run dev:env`.

# Browser-safe, injected at build time.
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_PUBLISHABLE_KEY=<from-local-supabase-status>
VITE_APP_ENV=development
VITE_APP_MODE=production
VITE_DEMO_MODE=false

# Server-only runtime values. Never expose the service-role key to VITE_*.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=<from-local-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<from-local-supabase-status>

# Local application runtime.
APP_MODE=production
DEMO_MODE=false
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://127.0.0.1:8080
LOG_LEVEL=debug

# Disposable local-only smoke-test account. Change if desired.
LOCAL_DEV_EMAIL=dev@local.test
LOCAL_DEV_PASSWORD=LocalDevOnly!2026
