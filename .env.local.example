# Local development template. Generate the real ignored file with `npm.cmd run dev:env`.

# Browser-safe build-time values.
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_PUBLISHABLE_KEY=<from-local-supabase-status>
VITE_APP_ENV=development

# Server-only local values.
DATABASE_URL=<from-local-supabase-status>
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLISHABLE_KEY=<from-local-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<from-local-supabase-status>
SESSION_SECRET=<local-random-secret>
SETUP_SECRET=<local-random-secret-at-least-24-characters>
INTERNAL_CRON_TOKEN=<local-random-secret>
WEBHOOK_DISPATCH_SECRET=<local-random-secret>
WIDGET_SIGNING_SECRET=<local-random-secret>
APP_USER_CONNECTION_KEY_SECRET=<local-random-secret>
WA_QR_WEBHOOK_SECRET=<local-random-secret>
WA_QR_WORKER_TOKEN=<local-random-secret>
WA_QR_WORKER_SIGNING_SECRET=<local-random-secret>

NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://127.0.0.1:8080
LOG_LEVEL=debug

# Disposable local-only smoke-test account; not customer-facing demo data.
LOCAL_DEV_EMAIL=dev@local.test
LOCAL_DEV_PASSWORD=<local-random-password>
